#!/usr/bin/env bash
# Runs a checkpoint notebook headlessly and converts its report into a
# CI-style exit code.
#
# This is what makes "CI runs the actual notebook" literally true: it
# starts a real Livebook server, deploys the notebook as an app via
# LIVEBOOK_APPS_PATH (Livebook's own execution path, not an extraction
# of the notebook's code), lets it run, then hands the resulting report
# to bin/check_report.exs.
#
# Usage:
#   bin/run_checkpoint [--timeout SECONDS] [NOTEBOOK]
#
#   NOTEBOOK defaults to livebooks/hcw_orbital_mechanics.livemd.
#
# Any notebook that loads livebooks/checkpoint.exs, declares a manifest
# with Checkpoint.init/1, records results with Checkpoint.check/3 and
# ends with Checkpoint.complete/0 can be run this way — which is how a
# second notebook asserting some further invariant gets gated without
# changing this script.
#
# Only the named notebook is deployed: it is copied into a temporary
# apps directory of its own. Pointing LIVEBOOK_APPS_PATH at livebooks/
# wholesale would deploy every notebook there, including ones that draw
# rather than check, and they would race on the same report file.
#
# Exits 0 only if the notebook completed (wrote its sentinel) AND every
# check declared in its manifest is present AND every one is ok:true.
# Any other outcome — a timeout, an uncaught exception aborting
# evaluation partway through, a missing check, or a recorded failure —
# exits 1.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TIMEOUT=120
NOTEBOOK="$ROOT_DIR/livebooks/hcw_orbital_mechanics.livemd"

while [ $# -gt 0 ]; do
  case "$1" in
    --timeout)
      TIMEOUT="$2"
      shift 2
      ;;
    -h | --help)
      sed -n '2,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      NOTEBOOK="$1"
      shift
      ;;
  esac
done

if [ ! -f "$NOTEBOOK" ]; then
  echo "No such notebook: $NOTEBOOK" >&2
  exit 1
fi

NOTEBOOK="$(cd "$(dirname "$NOTEBOOK")" && pwd)/$(basename "$NOTEBOOK")"
NOTEBOOK_NAME="$(basename "$NOTEBOOK" .livemd)"

if ! grep -q "Checkpoint.complete" "$NOTEBOOK"; then
  echo "warning: $NOTEBOOK_NAME never calls Checkpoint.complete/0, so it can" >&2
  echo "         never report completion. If it is a notebook that draws" >&2
  echo "         rather than checks, it is not meant to be run this way." >&2
fi

SERVER_LOG="$(mktemp -t plumbline_checkpoint_server.XXXXXX.log)"
DATA_PATH="$(mktemp -d -t plumbline_livebook_data.XXXXXX)"
APPS_PATH="$(mktemp -d -t plumbline_livebook_apps.XXXXXX)"
PORT="${PLUMBLINE_CHECKPOINT_PORT:-8055}"

cp "$NOTEBOOK" "$APPS_PATH/"

# Runs are kept, one per notebook, named by UTC start time. The point is
# the series, not the latest one: read in order they show an
# implementation converging on the invariants, or regressing away from
# them. bin/checkpoint_history.exs renders that. Reports are committed,
# deliberately and in full — see .gitignore for why they must not be
# pruned or hand-picked.
#
# PLUMBLINE_REPORT_PATH overrides the location for a one-off run.
REPORTS_DIR="$ROOT_DIR/reports/$NOTEBOOK_NAME"
mkdir -p "$REPORTS_DIR"
REPORT_PATH="${PLUMBLINE_REPORT_PATH:-$REPORTS_DIR/$(date -u +%Y%m%dT%H%M%SZ).jsonl}"

# Provenance: capture the working tree that produced this run.
#
# A report is only interpretable against the code that produced it.
# Agents working in this repository do not make commits, so there is no
# commit to anchor a run to — and anchoring to commits would be worse
# anyway, since commits are curated by definition and would reintroduce
# the selection bias that keeping every report exists to avoid. So each
# run captures its own diff, written beside the report and named to
# match it: 20260101T000000Z.jsonl pairs with 20260101T000000Z.diff.
#
# Captured BEFORE evaluation, deliberately — the tree that produced the
# result is the one at launch, not whatever it has become by the time
# the run ends. The pointer into the report is appended AFTER, because
# Checkpoint.init/1 truncates the report file and would destroy anything
# written ahead of it.
#
# Every git call here is read-only (rev-parse, diff, status, ls-files,
# hash-object) and every one is guarded. On a machine with no git, or an
# unpacked download that is not a repository, provenance is skipped and
# the checkpoint runs normally. Capturing provenance must never be able
# to fail a run — `set -e` would otherwise turn a missing git into a
# failed invariant, which is a lie.
SNAPSHOT_PATH="${REPORT_PATH%.jsonl}.diff"
SNAPSHOT_WRITTEN=0
GIT_HEAD=""
DIFF_SHA=""
UNTRACKED_COUNT=0
DIRTY=false

if git -C "$ROOT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  GIT_HEAD="$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo "")"
  # reports/ is itself untracked until committed, so listing it here
  # would make every snapshot header enumerate every earlier run — noise
  # that grows with the series. Generated output is not source state.
  UNTRACKED_LIST="$(git -C "$ROOT_DIR" ls-files --others --exclude-standard 2>/dev/null |
    grep -v '^reports/' || true)"
  UNTRACKED_COUNT="$(printf '%s' "$UNTRACKED_LIST" | grep -c . || true)"

  # A reused PLUMBLINE_REPORT_PATH would overwrite the previous run.
  # Move it aside instead — reports are kept in full, and a run
  # displaced by a re-run is still a run.
  #
  # Report and snapshot are archived *together*, under one suffix, and
  # their cross-references are rewritten to point at each other rather
  # than at the live pair about to replace them. Archiving the two
  # independently looks equivalent and is not: each would keep naming
  # the other's original filename, so both archived files would point at
  # the next run's data.
  #
  # Checkpoint.init/1 carries the same guard for the interactive path,
  # where there is no wrapper and so no snapshot to pair. Moving the
  # report here means it finds nothing left to archive.
  if [ -s "$SNAPSHOT_PATH" ] || [ -s "$REPORT_PATH" ]; then
    ARCHIVE_BASE="${REPORT_PATH%.jsonl}"
    ARCHIVE_N=1

    while [ -e "$(printf '%s-superseded-%02d.jsonl' "$ARCHIVE_BASE" "$ARCHIVE_N")" ] ||
      [ -e "$(printf '%s-superseded-%02d.diff' "$ARCHIVE_BASE" "$ARCHIVE_N")" ]; do
      ARCHIVE_N=$((ARCHIVE_N + 1))
    done

    ARCHIVED_JSONL="$(printf '%s-superseded-%02d.jsonl' "$ARCHIVE_BASE" "$ARCHIVE_N")"
    ARCHIVED_DIFF="$(printf '%s-superseded-%02d.diff' "$ARCHIVE_BASE" "$ARCHIVE_N")"

    if [ -s "$SNAPSHOT_PATH" ]; then
      mv "$SNAPSHOT_PATH" "$ARCHIVED_DIFF" || true
      sed -i "s|^# report:    $(basename "$REPORT_PATH")$|# report:    $(basename "$ARCHIVED_JSONL")|" \
        "$ARCHIVED_DIFF" 2>/dev/null || true
    fi

    if [ -s "$REPORT_PATH" ]; then
      mv "$REPORT_PATH" "$ARCHIVED_JSONL" || true
      sed -i "s|\"snapshot\":\"$(basename "$SNAPSHOT_PATH")\"|\"snapshot\":\"$(basename "$ARCHIVED_DIFF")\"|" \
        "$ARCHIVED_JSONL" 2>/dev/null || true
    fi

    echo "previous run at this path archived as $(basename "$ARCHIVED_JSONL")"
  fi

  {
    echo "# plumbline checkpoint snapshot"
    echo "# report:    $(basename "$REPORT_PATH")"
    echo "# notebook:  $NOTEBOOK_NAME"
    echo "# captured:  $(date -u +%Y-%m-%dT%H:%M:%SZ), before evaluation"
    echo "# HEAD:      ${GIT_HEAD:-<no commits>}"
    echo "#"
    echo "# Working-tree changes against HEAD, plus untracked files listed"
    echo "# below. This is the exact state the paired report describes."

    if [ "$UNTRACKED_COUNT" -gt 0 ]; then
      echo "#"
      echo "# untracked ($UNTRACKED_COUNT):"
      printf '%s\n' "$UNTRACKED_LIST" | sed 's/^/#   /'
    fi

    echo "# ----------------------------------------------------------"

    if [ -n "$GIT_HEAD" ]; then
      git -C "$ROOT_DIR" diff HEAD 2>/dev/null || true
    fi
  } >"$SNAPSHOT_PATH"

  SNAPSHOT_WRITTEN=1
  DIFF_SHA="$(git -C "$ROOT_DIR" hash-object "$SNAPSHOT_PATH" 2>/dev/null | cut -c1-12 || echo "")"

  if [ -n "$GIT_HEAD" ] && ! git -C "$ROOT_DIR" diff --quiet HEAD 2>/dev/null; then
    DIRTY=true
  elif [ "$UNTRACKED_COUNT" -gt 0 ]; then
    DIRTY=true
  fi
fi

SERVER_PID=""

cleanup() {
  [ -n "$SERVER_PID" ] && kill "$SERVER_PID" 2>/dev/null || true
  rm -rf "$SERVER_LOG" "$DATA_PATH" "$APPS_PATH"
}
trap cleanup EXIT

echo "Running $NOTEBOOK_NAME headlessly (timeout ${TIMEOUT}s)..."

# PLUMBLINE_PROJECT_PATH: in app mode Livebook evaluates an autosaved
# copy of the notebook, so the notebook's own `__DIR__` points at the
# autosave directory rather than the repository. Notebooks prefer this
# variable when it is set. It is also what makes the copy above safe.
#
# LIVEBOOK_DATA_PATH: an isolated, ephemeral data directory, so a run
# never inherits state from a previous one or from a developer's own
# Livebook installation.
PLUMBLINE_REPORT_PATH="$REPORT_PATH" \
PLUMBLINE_PROJECT_PATH="$ROOT_DIR" \
LIVEBOOK_APPS_PATH="$APPS_PATH" \
LIVEBOOK_DATA_PATH="$DATA_PATH" \
  livebook server --port "$PORT" >"$SERVER_LOG" 2>&1 &
SERVER_PID=$!

# Livebook's server never exits on its own — it goes on serving the
# deployed app indefinitely — so the run has to be ended from out here.
# Rather than always waiting out the full timeout, poll for the
# completion sentinel the notebook writes as its last cell and stop as
# soon as it lands. A run that finishes in 20s then costs 20s, which
# matters a great deal when iterating.
#
# A run that aborts partway (an uncaught exception, e.g. a function that
# still raises) writes no sentinel and so pays the full timeout. That is
# unavoidable: an abort leaves no signal to wait for.
WAITED=0
COMPLETED=0

while [ "$WAITED" -lt "$TIMEOUT" ]; do
  if [ -s "$REPORT_PATH" ] && grep -q '"complete"' "$REPORT_PATH" 2>/dev/null; then
    COMPLETED=1
    break
  fi

  kill -0 "$SERVER_PID" 2>/dev/null || break

  sleep 1
  WAITED=$((WAITED + 1))
done

kill "$SERVER_PID" 2>/dev/null || true
wait "$SERVER_PID" 2>/dev/null || true
SERVER_PID=""

if [ "$COMPLETED" -eq 1 ]; then
  echo "Notebook finished in ~${WAITED}s."
else
  echo "No completion sentinel after ${WAITED}s (timeout ${TIMEOUT}s)."
fi

# The pointer to the snapshot goes in now rather than before the run,
# because Checkpoint.init/1 truncates the report file on its way past.
# Appended unconditionally, including when the notebook produced no
# report at all: a run that failed to start is still a run, and its
# snapshot is still the state that failed to start. checkpoint_history
# renders such a report as "no manifest" rather than hiding it.
if [ "$SNAPSHOT_WRITTEN" -eq 1 ]; then
  printf '{"snapshot":"%s","head":"%s","diff_sha":"%s","dirty":%s,"untracked":%s}\n' \
    "$(basename "$SNAPSHOT_PATH")" "$GIT_HEAD" "$DIFF_SHA" "$DIRTY" "$UNTRACKED_COUNT" \
    >>"$REPORT_PATH"
fi

echo "--- notebook server log (tail) ---"
tail -n 40 "$SERVER_LOG" || true
echo "-----------------------------------"
echo "report:   $REPORT_PATH"

if [ "$SNAPSHOT_WRITTEN" -eq 1 ]; then
  echo "snapshot: $SNAPSHOT_PATH  (HEAD ${GIT_HEAD:-none}, diff ${DIFF_SHA:-none})"
fi

# check_report.exs halts non-zero on failure, and `set -e` ends the
# script there, so the report path is printed above this line rather
# than below it.
elixir "$ROOT_DIR/bin/check_report.exs" "$REPORT_PATH"
